      "type": "string"
    },
    "required_margin": {
      "title": "Required Margin",
      "type": "number"
    },
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "winner": {
      "title": "Winner",
      "type": "string"
    },
    "winner_kind": {
      "enum": [
        "baseline",
        "complex"
      ],
      "title": "Winner Kind",
      "type": "string"
    }
  },
  "required": [
    "winner",
    "winner_kind",
    "reason",
    "metric",
    "required_margin",
    "best_baseline",
    "best_complex",
    "improvement_over_baseline",
    "improvement_over_naive",
    "ranking",
    "explanation"
  ],
  "title": "Selection",
  "type": "object"
