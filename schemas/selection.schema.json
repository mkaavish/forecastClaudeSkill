{
  "$defs": {
    "RankedModel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "baseline",
            "complex"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "name",
        "kind",
        "score",
        "rank"
      ],
      "title": "RankedModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The deterministic model choice. Claude explains it; it never makes it.",
  "properties": {
    "best_baseline": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Best Baseline"
    },
    "best_complex": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Best Complex"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "improvement_over_baseline": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Improvement Over Baseline"
    },
    "improvement_over_naive": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Improvement Over Naive"
    },
    "metric": {
      "enum": [
        "mase",
        "mae"
      ],
      "title": "Metric",
      "type": "string"
    },
    "ranking": {
      "items": {
        "$ref": "#/$defs/RankedModel"
      },
      "title": "Ranking",
      "type": "array"
    },
    "reason": {
