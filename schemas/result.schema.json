      "type": "object"
    },
    "PointForecast": {
      "additionalProperties": false,
      "properties": {
        "ds": {
          "title": "Ds",
          "type": "string"
        },
        "forecast": {
          "title": "Forecast",
          "type": "number"
        },
        "hi_80": {
          "title": "Hi 80",
          "type": "number"
        },
        "hi_95": {
          "title": "Hi 95",
          "type": "number"
        },
        "lo_80": {
          "title": "Lo 80",
          "type": "number"
        },
        "lo_95": {
          "title": "Lo 95",
          "type": "number"
        }
      },
      "required": [
        "ds",
        "forecast",
        "lo_80",
        "hi_80",
        "lo_95",
        "hi_95"
      ],
      "title": "PointForecast",
      "type": "object"
    },
    "ProfileReport": {
      "additionalProperties": false,
      "properties": {
        "constant": {
          "title": "Constant",
          "type": "boolean"
        },
        "input": {
          "$ref": "#/$defs/LoadReport"
        },
        "intermittency": {
          "$ref": "#/$defs/Intermittency"
        },
        "near_constant": {
          "title": "Near Constant",
          "type": "boolean"
        },
        "outliers": {
          "$ref": "#/$defs/OutlierSummary"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "seasonality": {
          "$ref": "#/$defs/Seasonality"
        },
        "stats": {
          "$ref": "#/$defs/Stats"
        },
        "status": {
          "const": "ok",
