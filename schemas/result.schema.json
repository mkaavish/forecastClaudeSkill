        "warnings": {
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "input",
        "stats",
        "constant",
        "near_constant",
        "intermittency",
        "outliers",
        "trend",
        "seasonality"
      ],
      "title": "ProfileReport",
      "type": "object"
    },
    "RankedModel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "baseline",
            "complex"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "name",
        "kind",
        "score",
        "rank"
      ],
      "title": "RankedModel",
      "type": "object"
