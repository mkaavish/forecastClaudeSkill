          "items": {
            "$ref": "#/$defs/SeasonalityCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "multiple": {
          "title": "Multiple",
          "type": "boolean"
        },
        "season_length": {
          "title": "Season Length",
          "type": "integer"
        },
        "trend_strength": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trend Strength"
        }
      },
      "required": [
        "candidates",
        "season_length",
        "multiple",
        "trend_strength"
      ],
      "title": "Seasonality",
      "type": "object"
