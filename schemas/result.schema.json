    "SeasonalityCandidate": {
      "additionalProperties": false,
      "properties": {
        "cycles": {
          "title": "Cycles",
          "type": "number"
        },
        "detected": {
          "title": "Detected",
          "type": "boolean"
        },
        "independent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
